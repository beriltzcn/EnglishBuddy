@model List<EnglishBuddy.Models.WordCard>

@{
    ViewData["Title"] = "My Words";
}

<h1>My Words</h1>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Word</a>

@if (Model.Count == 0)
{
    <p class="text-muted">No words yet. Add your first word card!</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Word</th>
                <th>Meaning</th>
                <th>Example</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model)
            {
                <tr>
                    <td>
                        @card.Word
                        <button type="button" class="btn btn-sm btn-light"
                                title="Listen"
                                onclick="speakWord('@card.Word')">
                            🔊
                        </button>
                    </td>
                    <td>@card.Meaning</td>
                    <td>@card.ExampleSentence</td>
                </tr>
            }
        </tbody>
    </table>
}
