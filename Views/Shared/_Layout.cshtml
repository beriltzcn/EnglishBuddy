<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishBuddy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="navbar navbar-expand-lg fd-nav py-2">
        <div class="container">
            <a class="fd-brand" asp-controller="Home" asp-action="Index">
                <span class="fd-brand-icon">🇬🇧</span>
                English<em>Buddy</em>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav fd-links ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Card" asp-action="Index">📚 My Words</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Card" asp-action="Review">🎯 Review</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Card" asp-action="Create">➕ Add Word</a>
                    </li>
                    <a class="nav-link" asp-controller="Chat" asp-action="Index">💬 Chat</a>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="fd-footer">
        <div class="container">EnglishBuddy &middot; Learn a word a day 🚀</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>